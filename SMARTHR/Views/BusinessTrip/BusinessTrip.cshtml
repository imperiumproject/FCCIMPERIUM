<script type="text/javascript">

	document.addEventListener('DOMContentLoaded', () => {
		// const cancelButton = document.getElementById('cancelBusinessButton');
		// const btncreatenewrequest = document.getElementById('btncreatenewrequest');
		// if (cancelButton) {
		// 	cancelButton.addEventListener('click', function () {

		// 	});
		// } else {
		// 	console.error('Cancel button (#cancelBusinessButton) not found');
		// }
		//Bind Data Leave
		if (btncreatenewrequest) {
			btncreatenewrequest.addEventListener('click', function () {
				$('#btnBtripSave').show();
				$('#btnUpdate').hide();
				$('#btnBTRecall').hide()
				fetchBusinessTripId();
				BindAllEmployee();
			});
		} else {
			console.error('Create button (#btncreatenewrequest) not found');
		}


	});


	//----------------------dates
	  flatpickr("#eventstartdate", {
	  dateFormat: "d/m/Y", // Flatpickr uses lowercase m/d/Y for MM/dd/yyyy
	  allowInput: true
	});
	  flatpickr("#eventenddate", {
	  dateFormat: "d/m/Y",  // MM/dd/yyyy format
	  allowInput: true
	});
	//----------------dates


		async function fetchBusinessTripId() {
		$.ajax({
			url: '/BusinessTrip/GetBusinessTripId',
			type: 'POST',
			success: function (data) {
				if (data !== "Error") {
					$('#requestid').val(data);
				} else {
					alert("Failed to get request id.");
				}
			},
			error: function (xhr, status, error) {
				console.error("Error fetching request id:", error);
				alert("Something went wrong while fetching the request id.");
			}
		});
	}	

	function BindAllEmployee(employeeIdToSelect) {
		// Get the anti-forgery token
		var token = $('input[name="__RequestVerificationToken"]').val();

		// Make AJAX call to GetAllEmployees
		$.ajax({
			url: '@Url.Action("GetAllEmployees", "Leave")',
			type: 'POST',
			data: {
				__RequestVerificationToken: token
			},
			dataType: 'json',
			beforeSend: function () {
				$('.container').prepend('<div class="loading">Loading...</div>');
			},
			success: function (response) {
				$('.loading').remove();
				console.log('AJAX response:', JSON.stringify(response, null, 2)); // Detailed debug output

				let employeeList = null;
				if (Array.isArray(response)) {
					employeeList = response; // Direct array from List<EmployeeList>
				} else if (response && response.EmployeeList && Array.isArray(response.EmployeeList)) {

	// Global array to store file data
	let attachRefList = [];

	function BindAttachCreate() {
		return new Promise((resolve, reject) => {
			attachRefList = []; // Clear previous attachments
			const fileInput = $('#attachments')[0];
			const files = fileInput?.files;

			if (!fileInput || !files || files.length === 0) {
				resolve(); // No files selected, proceed with empty attachRefList
				return;
			}

			let processedFiles = 0;
			for (let i = 0; i < files.length; i++) {
				const file = files[i];

				// Validate file size and type (optional, uncomment if needed)
				/*
				if (file.size > 5 * 1024 * 1024) { // Limit to 5MB
					reject(`File ${file.name} is too large. Maximum size is 5MB.`);
					return;
				}
				if (!['application/pdf', 'image/jpeg', 'image/png'].includes(file.type)) {
					reject(`File ${file.name} is not a supported type (PDF, JPG, PNG).`);
					return;
				}
				*/

				const reader = new FileReader();
				reader.onload = function (e) {
					const base64String = e.target.result.split(',')[1]; // Extract Base64 string
					attachRefList.push({
						fileName: file.name,
						attachRef: base64String
					});

					processedFiles++;
					if (processedFiles === files.length) {
						resolve(); // All files processed
					}
				};

				reader.onerror = function () {
					reject(`Error reading file: ${file.name}`);
				};

				reader.readAsDataURL(file);
			}
		});
	}



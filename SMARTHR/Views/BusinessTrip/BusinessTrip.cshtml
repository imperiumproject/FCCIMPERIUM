@model List<SMARTHR.WEB.Models.BusinessTripDeatils>
@{
	ViewData["Title"] = "BusinessTrip";
}

<div class="content">

	<!-- Breadcrumb -->
	<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
		<div class="my-auto mb-2">
			<h2 class="mb-1">Request</h2>
			<nav>
				<ol class="breadcrumb mb-0">
					<li class="breadcrumb-item">
						<a href="index.html"><i class="ti ti-smart-home"></i></a>
					</li>
					<li class="breadcrumb-item">
						Payroll
					</li>
					<li class="breadcrumb-item active" aria-current="page">Business Trip List</li>
				</ol>
			</nav>
		</div>
		<div class="d-flex my-xl-auto right-content align-items-center flex-wrap ">

			<div class="mb-2">
				<a href="#" data-bs-toggle="modal" id="btncreatenewrequest" data-bs-target="#add_employee" class="btn btn-primary d-flex align-items-center"><i class="ti ti-circle-plus me-2"></i>Create New</a>
			</div>

		</div>
	</div>
	<!-- /Breadcrumb -->



	<div class="card">
		<div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
			<h5>Business Trip List</h5>
			<div class="d-flex my-xl-auto right-content align-items-center flex-wrap row-gap-3">

				<div class="dropdown me-3">
					<a href="javascript:void(0);" class="dropdown-toggle btn btn-white d-inline-flex align-items-center" data-bs-toggle="dropdown">
						Employee
					</a>
					<ul class="dropdown-menu  dropdown-menu-end p-3">
						<li>
							<a href="javascript:void(0);" class="dropdown-item rounded-1">Finance</a>
						</li>
						<li>
							<a href="javascript:void(0);" class="dropdown-item rounded-1">Developer</a>
						</li>
						<li>
							<a href="javascript:void(0);" class="dropdown-item rounded-1">Executive</a>
						</li>
					</ul>
				</div>
				<div class="dropdown me-3">
					<a href="javascript:void(0);" class="dropdown-toggle btn btn-white d-inline-flex align-items-center" data-bs-toggle="dropdown">
						Select Status
					</a>
					<ul class="dropdown-menu  dropdown-menu-end p-3">
						<li>
							<a href="javascript:void(0);" class="dropdown-item rounded-1">Active</a>
						</li>
						<li>
							<a href="javascript:void(0);" class="dropdown-item rounded-1">Inactive</a>
						</li>
					</ul>
				</div>
				<button class="btn  bg-primary btn-wave waves-effect waves-light">
					<i class="feather-download align-middle me-2 d-inline-block"></i>Search
				</button>

			</div>
		</div>
		<div class="card-body p-0">
			<div class="custom-datatable-filter table-responsive">
				<table class="table datatable">
					<thead class="thead-light">
						<tr>

							<th>Request ID</th>
							<th>Employee Name</th>
							<th>Request Type</th>
							<th>Event Start Date</th>
							<th>Event End Date</th>
							<th>Status</th>
							<th>Actions</th>
							<th>Workflow History</th>
						</tr>
					</thead>
					<tbody>

						@if (Model != null && Model.Any())
						{
							foreach (var item in Model)
							{
								<tr>
									<td><a href="@Url.Action("Details", "Leave", new { id = item.BusinessTripReqId })">@item.BusinessTripReqId</a></td>
									<td>@item.EmployeeName</td>
									<td>@item.BusinessTripsExpenseType</td>
									<td>@Convert.ToString(item.FromDate)</td>
									<td>@Convert.ToString(item.ToDate)</td>
									<td>

										<span class="badge @(item.WorkflowStatus == "Draft" ? "badge-danger" : "badge-success") d-inline-flex align-items-center badge-xs">
											<i class="ti ti-point-filled me-1"></i>@item.WorkflowStatus
										</span>
									</td>
									<td>
										<div class="action-icon d-inline-flex">
											<a href="#" class="me-2 btnRecall" id="btnRecall" name="btnRecall" data-bs-toggle="modal" data-id="@item.BusinessTripReqId,@item.BusinessTripRecId,@item.TableId" data-bs-target="#add_employee"><i class="ti ti-history" title="Recall"></i></a>
											@if (item.WorkflowStatus == "Approved")
											{
											<a class="me-2 btnView" id="btnView" name="btnView" data-id="@item.BusinessTripReqId" data-bs-toggle="modal" data-bs-target="#add_employee"><i class="ti ti-edit"></i></a>
											<a class="me-2 btnDelete" data-bs-target="#delete_modal" id="btnDelete" name="btnDelete" data-id="@item.BusinessTripReqId"><i class="ti ti-trash"></i></a>
											}
											else{
												<a class="me-2 btnView" id="btnView" name="btnView" data-id="@item.BusinessTripReqId" data-bs-toggle="modal" data-bs-target="#add_employee"><i class="ti ti-eye"></i></a>
											}
										</div>
									</td>
									<td>
										<a href="#" class="me-2 btnWFView" id="btnWFView" name="btnWFView" data-bs-toggle="modal" data-bs-target="#Workflow_History" data-leaveid="@item.BusinessTripReqId"
										   data-rec="@item.BusinessTripRecId" data-tableid="@item.TableId" data-transtype="Business Trip" title="View"><i class="ti ti-eye"></i></a>
									</td>
									
								</tr>
							}
						}
						else
						{
							<tr>
								<th></th>
								<th></th>
								<th></th>
								<th></th>
								<th></th>
								<th></th>
								<th></th>
								<th></th>
							</tr>

						}				
					</tbody>
				</table>
			</div>
		</div>
	</div>

</div>

<script>
	function addEditableRow() {
		const tbody = document.getElementById('dataTableBody');
		const row = document.createElement('tr');

		row.innerHTML = `
		<td>
		<select class="form-control">
		<option value="">Select Type</option>
		<option value="Travel">Travel</option>
		<option value="Food">Food</option>
		<option value="Accommodation">Accommodation</option>
		<option value="Other">Other</option>
		</select>
		</td>
		<td><input type="text" class="form-control" placeholder="Description"></td>
		<td><input type="number" class="form-control" placeholder="Amount"></td>
		<td><input type="number" class="form-control" placeholder="Approved Amount"></td>
		<td><input type="text" class="form-control" placeholder="Comments"></td>
		<td>
		<button class="btn btn-primary btn-sm me-1" onclick="saveRow(this)">Save</button>
		<button class="btn btn-danger btn-sm" onclick="deleteRow(this)">Delete</button>
		</td>
			  `;

		tbody.appendChild(row);
	}

	function saveRow(button) {
		const row = button.closest('tr');
		const inputs = row.querySelectorAll('input, select');
		const values = [];

		inputs.forEach(input => {
			values.push(input.value || "-");
		});

		row.innerHTML = `
		<td>${values[0]}</td>
		<td>${values[1]}</td>
		<td>${values[2]}</td>
		<td>${values[3]}</td>
		<td>${values[4]}</td>
		<td>
		<button class="btn btn-warning btn-sm me-1" onclick="editRow(this)">Edit</button>
		<button class="btn btn-danger btn-sm" onclick="deleteRow(this)">Delete</button>
		</td>
			  `;
	}

	function editRow(button) {
		const row = button.closest('tr');
		const tds = row.querySelectorAll('td');
		const currentValues = Array.from(tds).slice(0, 5).map(td => td.textContent.trim());

		row.innerHTML = `
		<td>
		<select class="form-control">
		<option value="Travel" ${currentValues[0] === 'Travel' ? 'selected' : ''}>Travel</option>
		<option value="Food" ${currentValues[0] === 'Food' ? 'selected' : ''}>Food</option>
		<option value="Accommodation" ${currentValues[0] === 'Accommodation' ? 'selected' : ''}>Accommodation</option>
		<option value="Other" ${currentValues[0] === 'Other' ? 'selected' : ''}>Other</option>
		</select>
		</td>
		<td><input type="text" class="form-control" value="${currentValues[1]}"></td>
		<td><input type="number" class="form-control" value="${currentValues[2]}"></td>
		<td><input type="number" class="form-control" value="${currentValues[3]}"></td>
		<td><input type="text" class="form-control" value="${currentValues[4]}"></td>
		<td>
		<button class="btn btn-primary btn-sm me-1" onclick="saveRow(this)">Save</button>
		<button class="btn btn-danger btn-sm" onclick="deleteRow(this)">Delete</button>
		</td>
			  `;
	}

	function deleteRow(button) {
		const row = button.closest('tr');
		row.remove();
	}
</script>
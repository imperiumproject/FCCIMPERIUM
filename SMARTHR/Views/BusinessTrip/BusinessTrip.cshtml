	$(document).on('click', '.btnRecall', function (e) {
		e.preventDefault(); // Prevent default link behavior

		// Parse data-id (e.g., "123,456,789" into [LeaveID, LeaveRecId, WorkflowTableId])
		var idData = $(this).data('id').split(',');
		if (idData.length < 3) {
			alert('Invalid data-id format');
			return;
		}
		var leaveId = idData[0] || '';
		var leaveRecId = idData[1] || ''; // Not used in AJAX, but kept for potential future use
		var workflowTableId = idData[2] || '';
		var TransType = 'Business Trip';
		// Make AJAX call to fetch workflow data
		$.ajax({
			url: '@Url.Action("RecallWorkFlow", "BusinessTrip")',
			type: 'GET',
			data: {
				RecordId: leaveRecId,
				TableId: workflowTableId,
				TransType: TransType
			},
			dataType: 'json',
			success: function (response) {
				// Check if wfTrackingList exists and has items
				if (response.wfTrackingList && response.wfTrackingList.length > 0) {
					// Clean up any previous dynamic header content
					$('#Workflow_History .modal-header .d-flex div.me-2').remove();

					// Update modal header with wFTransID and raisedBy
					var firstEntry = response.wfTrackingList[0];
					$('#Workflow_History .modal-title + span').text('Employee ID: ' + (firstEntry.raisedBy || ''));
					$('#Workflow_History .modal-header .d-flex').prepend(
						'<div class="me-2">WF Trans ID: ' + (firstEntry.wFTransID || '') + '</div>'
					);

					// Update Request ID in the first thead
					$('#Workflow_History .datatable thead:first-child tr th').text('Request ID: ' + (leaveId || ''));
					$('#Workflow_History .datatable tbody').empty();

					// Populate table with workflow data
					$.each(response.wfTrackingList, function (index, entry) {
						var row = $('<tr></tr>');
						row.append('<td>' + (entry.levelName || '') + '</td>');
						row.append('<td>' + (entry.employeeName || '') + '</td>');
						row.append('<td>' + (entry.status || '') + '</td>');
						row.append('<td>' + (entry.remarks || '') + '</td>');
						row.append('<td>' + (entry.comments || '') + '</td>');
						row.append('<td>' + (entry.transDate || '') + '</td>');
						$('#Workflow_History .datatable tbody').append(row);
					});

					// Initialize DataTables if used
					if ($.fn.DataTable) {
						$('#Workflow_History .datatable').DataTable().destroy();
						$('#Workflow_History .datatable').DataTable({
							paging: false,
							searching: false,
							info: false
						});
					}

					// Show the modal
					$('#Workflow_History').modal('show');
				} else {
					alert('Error: No workflow details found in response');
				}
			},
			error: function (xhr, status, error) {
				alert('An error occurred while fetching the data: ' + error);
				console.error('AJAX Error:', xhr.responseText);
			}
		});
	});




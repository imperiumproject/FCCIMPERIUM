			},
			success: function (response) {
				$('.loading').remove();
				console.log('AJAX response:', response); // Debug response
				if (response) {
					debugger;
					// Populate Leave Type dropdown
					var loanTypeSelect = $('#loantype');
					loanTypeSelect.empty().append('<option value="">Select</option>');

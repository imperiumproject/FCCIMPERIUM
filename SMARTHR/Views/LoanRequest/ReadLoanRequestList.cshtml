<script type="text/javascript">
	$(document).ready(function () {
		fetchLoanId();
		BindAllEmployee("");
		BindLoanType();

		// Global array to store file data
		let attachRefList = [];
		function BindAttachCreate() {
			return new Promise((resolve, reject) => {
				attachRefList = []; // Clear previous attachments
				const fileInput = $('#attachmentslist')[0];
				const files = fileInput?.files;

				if (!fileInput || !files || files.length === 0) {
					resolve(); // No file input or no files selected, proceed with empty attachRefList
					return;
				}

				let processedFiles = 0;
				for (let i = 0; i < files.length; i++) {
					const file = files[i];
					// Optional: Validate file size and type (uncomment if needed)
					/*
					if (file.size > 5 * 1024 * 1024) { // Limit to 5MB
						reject('File ' + file.name + ' is too large. Maximum size is 5MB.');
						return;
					}
					if (!['application/pdf', 'image/jpeg', 'image/png'].includes(file.type)) {
						reject('File ' + file.name + ' is not a supported type (PDF, JPG, PNG).');
						return;
					}
					*/

					const reader = new FileReader();
					reader.onload = function (e) {
						const base64String = e.target.result.split(',')[1]; // Extract Base64 string (remove data URI prefix)
						attachRefList.push({
							fileName: file.name,
							attachRef: base64String
						});

						processedFiles++;
						if (processedFiles === files.length) {
							resolve(); // All files processed
						}
					};

					reader.onerror = function () {
						reject('Error reading file: ' + file.name);
					};

					reader.readAsDataURL(file); // Read file as Data URL to get Base64
				}
			});
		}



		$('.btn-success').on('click', function (e) {
			e.preventDefault(); // Prevent default form submission
			// Collect form data
			BindAttachCreate().then(() => {
				var loanId = $('#loanid').val() || '';
				var employeeId = $('#worker').find('option:selected').val() || '';
				var EmployeeName = $('#worker').find('option:selected').text() || '';
				var raisedBy = '';
				var loandate = $('#loandate').val() || '';
				var loanDeduction = $('#loandeductionstartdate').val() || '';
				var loanType = $('#loantype').find('option:selected').text() || '';
				var comments = $('#remarks').val() || '';;
				var companyId = null;
				var amount = $('#amount').val() || '';
				var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
				// Debug: Log form data
				console.log('Form Data:', {
					companyId: companyId,
					employeeId: employeeId,
					raisedBy: raisedBy,
					loanType: loanType,
					comments: comments,
					loanId: loanId,
					loanDeduction: loanDeduction,
					amount:amount,
					attachRefList: attachRefList,
					__RequestVerificationToken: antiForgeryToken
				});

				// Basic client-side validation
				if (!employeeId || employeeId === 'Select') {
					$('#errorMessage').html('<p style="color: red;">Please select a valid employee.</p>');
					$('#employeename').focus();
					return false;
				}
				if (!loanDeduction || !loandate) {
					$('#errorMessage').html('<p style="color: red;">Please provide valid loan date and deduction start dates.</p>');
					$('#requiredby').focus();
					return false;
				}
				if (loanType === 'Select' || loanType === '') {
					$('#errorMessage').html('<p style="color: red;">Please select a valid loan type</p>');
					$('#loantype').focus();
					return false;
				}
				if (!loanId) {
					$('#errorMessage').html('<p style="color: red;">Please provide a valid request id.</p>');
					$('#loanid').focus();
					return false;
				}
				if (!amount) {
					$('#errorMessage').html('<p style="color: red;">Please enter loan amount.</p>');
					$('#amount').focus();
					return false;
				}
				// Prepare JSON payload
				var payload = {
					loanTableContract: {
						companyId: companyId,
						employeeId: employeeId,
						amount: amount,
						loanDate: loandate,
						loanDeduction: loanDeduction,
						loanType: loanType,
						raisedBy: raisedBy,
						loanId: loanId,
						comments: comments,
						attachRefList: attachRefList,
						__RequestVerificationToken: antiForgeryToken
					}
				};

				// Make AJAX request
				$.ajax({
					url: '/LoanRequest/CreateLoanRequest',
					type: 'POST',
					data: JSON.stringify(payload),
					contentType: 'application/json',
					headers: {
						'RequestVerificationToken': antiForgeryToken
					},
					beforeSend: function () {
						$('.btn-success').prop('disabled', true).text('Submitting...');
					},
					success: function (response) {
						debugger;
						if (response.messageFlag !== 'Failed' && !response.message.includes('API call failed')) {
							$('#success_modal .modal-body h5').text('Loan is created successfully');
							$('#success_modal .modal-body p').html(
								`${EmployeeName} has been scheduled for a Loan Request with Request ID: <span class="text-primary">${loanId || '#ITAR-0001'}</span>`
							);
							$('#success_modal').modal('show');
							$('.btn-success').prop('disabled', false).text('Submit');
							var successMessage = (response.Message || response.message || 'Loan request is saved successfully!');
							$('#errorMessage').html('<p style="color: green;">' + successMessage + '</p>');
							$('#LoanRequestForm')[0].reset();
							attachRefList = []; // Clear attachments after successful submission
							$('#fileList').html('No files selected.'); // Clear file list display
						} else {
							var successMessage = (response.Message || response.message);
							$('#errorMessage').html('<p style="color: red;">' + successMessage + '</p>');
							$('.btn-success').prop('disabled', false).text('Submit');
						}
					},
					error: function (xhr) {
						var errorMessage = 'An error occurred while saving the request.';
						if (xhr.responseJSON) {
							errorMessage = xhr.responseJSON.message || xhr.responseJSON.Message || errorMessage;
						} else if (xhr.statusText) {
							errorMessage = xhr.statusText;
						}
						$('#errorMessage').html('<p style="color: red;">' + errorMessage + '</p>');
					},
					complete: function () {
						$('#btnItAssestSubmite').prop('disabled', false).text('Submit');
					}
				});
			}).catch(error => {
				$('#errorMessage').html('<p style="color: red;">' + error + '</p>');
				$('#btnItAssestSubmite').prop('disabled', false).text('Submit');
			});
		});


		// Optional: Display selected files in the UI
		$('#attachmentslist').on('change', function () {
			const files = this.files;
			let fileList = '';
			let count = 0;
			for (let i = 0; i < files.length; i++) {
				fileList += `<li>${files[i].name} (${(files[i].size / 1024).toFixed(2)} KB)</li>`;
				count++;
			}
			$('#fileList').html(fileList ? `<ul>${fileList}</ul>` : 'No files selected.');
			$('#noofattachment').val(count);
		});





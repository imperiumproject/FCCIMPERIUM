	function BindLoanType() {
		debugger;
		// Get the anti-forgery token
		var token = $('input[name="__RequestVerificationToken"]').val();
		var EmpId = null;
		// Make AJAX call to GetLeaveType
		$.ajax({
			url: '@Url.Action("GetLoanRequestTypes", "LoanRequest")',

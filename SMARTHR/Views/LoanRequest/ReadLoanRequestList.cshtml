	$(document).on('click', '.btnEditLoan', function () {
		var requestId = $(this).data('id');
		//------------------
		$.ajax({
			url: '@Url.Action("ReadLoanRequestDetails", "LoanRequest")',
			type: 'Get',
			data: { loanId: requestId }, // Use 'id' to match controller parameter
			dataType: 'json',
			success: function (response) {
				// Check if leaveDetails exists and has items
				if (response.loanRequestResult && response.loanRequestResult.length > 0) {

					var requestData = response.loanRequestResult[0];
					function formatDate(inputDate) {
						if (!inputDate) return '';
						var parts = inputDate.split('/');
						return `${parts[2]}-${parts[1]}-${parts[0]}`;
					}
					function formatDateReverse(inputDate) {
						if (!inputDate) return '';
						var parts = inputDate.split('-');
						if (parts.length !== 3) return '';
						return `${parts[2]}/${parts[1]}/${parts[0]}`;
					}
					var $employeeNameDropdown = $('#add_employeeLoanItems #worker');
					var $loantypeDropdown = $('#add_employeeLoanItems #loantype');
					$employeeNameDropdown.val(requestData.employeeId).trigger('change').trigger('chosen:updated');
					$loantypeDropdown.find('option').filter(function () {
						return $(this).text() === requestData.loanType;
					}).prop('selected', true);
					$loantypeDropdown.trigger('change').trigger('chosen:updated');
					$('#add_employeeLoanItems #loanid').val(requestData.loanId);
					// $('#add_employeeLoan #worker').val(requestData.employeeId + '-' + requestData.employeeName);
					// $('#add_employeeLoan #loantype').val(requestData.loanType);
					$('#add_employeeLoanItems #amount').val(requestData.amount);
					$('#add_employeeLoanItems #loandate').val(formatDate(requestData.loanDate));
					$('#add_employeeLoanItems #loandeductionstartdate').val(formatDate(requestData.loanDeduction));
					$('#add_employeeLoanItems #remarks').val(requestData.remarks);
					if (requestData.status == 'Submitted' || requestData.status == 'Approved') {
						$('.btn-success').hide();
					}
					var table = $('#LoanAttachmentsTable').DataTable();
					$('#add_employeeLoanItems #attachmentcount').text(requestData.attachRefList.length);
					$.each(requestData.attachRefList, function (i, item) {
						// Determine the MIME type (default to octet-stream if unknown)
						let mimeType = item.fileType || 'application/octet-stream';

						// Construct download link using base64
						let downloadLink = `<a href="data:${mimeType};base64,${item.attachRef}"
										 download="${item.fileName}"
										 target="_blank">${item.fileName}</a>`;
						// Conditionally set the delete link based on requestData.status
						let deleteLink = (requestData.status === 'Submitted' || requestData.status === 'Approved')
							? `<span class="delete-attachment disabled" style="pointer-events: none; opacity: 0.5;"><i class="ti ti-trash"></i></span>`
							: `<a href="#" class="delete-attachment" data-attachment-id="${item.id || i}" data-bs-toggle="modal" data-bs-target="#delete_modal"><i class="ti ti-trash"></i></a>`;
						table.row.add([
							downloadLink,
							requestData.employeeId + '-' + requestData.employeeName,
							requestData.loanDate,
							deleteLink
						]).draw(false);
					});
					function formatDate(dateStr) {
						const d = new Date(dateStr);
						return d.toLocaleDateString("en-GB"); // dd/MM/yyyy
					}
				} else {
					alert('Error: No loan details found in response');
				}
			},
			error: function (xhr, status, error) {
				alert('An error occurred while fetching the data: ' + error);
				console.error('AJAX Error:', xhr.responseText); // Log response for debugging
			}
		});
	});

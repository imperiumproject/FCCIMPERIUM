<script>
	document.addEventListener('DOMContentLoaded', function () {
		let nextModalId = null;

		// Step 1: When a button is clicked, store the target modal ID
		document.querySelectorAll('.universal-modal-trigger').forEach(button => {
			button.addEventListener('click', function () {
				nextModalId = button.getAttribute('data-open-modal');
			});
		});

		// Step 2: On any modal hidden, check if we need to open another
		const allModals = document.querySelectorAll('.modal');
		allModals.forEach(modal => {
			modal.addEventListener('hidden.bs.modal', function () {
				if (nextModalId) {
					const nextModalEl = document.querySelector(nextModalId);
					if (nextModalEl) {
						const nextModal = new bootstrap.Modal(nextModalEl);
						nextModal.show();
					}
					nextModalId = null; // reset
				}
			});
		});
	});

	//--------------------------------JQeury Start from here
	$(document).ready(function () {
		BindAllEmployee("");
		BindPermissionType();
	});
	///------------------------------------------Bind All Employee
	//Bind All Employee
	function BindAllEmployee(employeeIdToSelect) {
		// Get the anti-forgery token
		var token = $('input[name="__RequestVerificationToken"]').val();

		// Make AJAX call to GetAllEmployees
		$.ajax({
			url: '@Url.Action("GetAllEmployees", "Leave")',
			type: 'POST',
			data: {
				__RequestVerificationToken: token
			},
			dataType: 'json',
			beforeSend: function () {
				$('.container').prepend('<div class="loading">Loading...</div>');
			},
			success: function (response) {
				$('.loading').remove();
				console.log('AJAX response:', JSON.stringify(response, null, 2)); // Detailed debug output

				let employeeList = null;
				if (Array.isArray(response)) {
					employeeList = response; // Direct array from List<EmployeeList>
				} else if (response && response.EmployeeList && Array.isArray(response.EmployeeList)) {
					employeeList = response.EmployeeList; // Wrapped in { "EmployeeList": [...] }
				} else if (response && response.data && Array.isArray(response.data)) {
					employeeList = response.data; // Wrapped in { "data": [...] }
				}

				if (employeeList && employeeList.length > 0) {
					var $select = $('#pworkername');
					$select.empty().append('<option value="">Select</option>');
					$.each(employeeList, function (index, item) {
						$select.append($('<option>', {
							value: item.employeeId,
							text: item.employeeName
						}));
					});
					$select.select2({
						dropdownParent: $('#myTabContent'),  // Replace with actual modal ID
						minimumResultsForSearch: 0
					});
					$select.val(employeeIdToSelect).trigger('change');
				}
			},
			error: function (xhr, status, error) {
				$('.loading').remove();
				console.error('AJAX error:', status, error, xhr.responseText);
				var errorDiv = $('<div class="alert alert-danger mt-3"></div>').text('An error occurred while loading employee data: ' + (xhr.responseText || error));
				$('.container').prepend(errorDiv);
			}
		});
	}


	function BindPermissionType() {
		debugger;
		// Get the anti-forgery token
		var token = $('input[name="__RequestVerificationToken"]').val();
		var EmpId = null;
		// Make AJAX call to GetLeaveType
		$.ajax({
			url: '@Url.Action("GetPermissionTypes", "PermissionRequest")',
			type: 'POST',
			data: { EmpId: EmpId, __RequestVerificationToken: token },
			dataType: 'json',
			beforeSend: function () {
				$('.container').prepend('<div class="loading">Loading...</div>');
			},
			success: function (response) {
				$('.loading').remove();
				console.log('AJAX response:', response); // Debug response
				if (response) {
					debugger;
					// Populate Leave Type dropdown
					var leavTypeSelect = $('#ptype');
					leavTypeSelect.empty().append('<option value="">Select</option>');
					var leavTypes = response;
					if (leavTypes && leavTypes.length > 0) {

						var $select = $('#ptype');
						$select.empty().append('<option value="">Select</option>');
						$.each(leavTypes, function (index, item) {
							$select.append($('<option>', {
								value: item.$id,
								text: item.leaveType
							}));
						});
						$select.select2({
							dropdownParent: $('#myTabContent'),  // Replace with actual modal ID
							minimumResultsForSearch: 0
						});
						//$select.val(EmpId).trigger('change');
					} else {
						console.log('No loan type found in response:', response.data);
						leavTypeSelect.append('<option value="" disabled>No loan types available</option>');
					}
				} else {
					var errorDiv = $('<div class="alert alert-danger mt-3"></div>').text(response.message || 'Failed to load dropdown data.');
					$('.container').prepend(errorDiv);
				}
			},
			error: function (xhr, status, error) {
				$('.loading').remove();
				console.error('AJAX error:', status, error, xhr.responseText);
				var errorDiv = $('<div class="alert alert-danger mt-3"></div>').text('An error occurred while loading dropdown data.');
				$('.container').prepend(errorDiv);
			}
		});
	}
</script>


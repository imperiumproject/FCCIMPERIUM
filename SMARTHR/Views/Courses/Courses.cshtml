<script>
	$(document).on('click', '#enrolleView', function () {
			var description = $(this).data('id');

			$.ajax({
				url: '@Url.Action("ReadCoursesInfo", "Courses")',
				type: 'POST',
				data: { description: description },
				dataType: 'json',
				success: function (response) {
					if (response.jobVacancyList && response.jobVacancyList.length > 0) {
						const jobData = response.jobVacancyList[0];

						//$('#openjobs').val(jobData.openJobs).val();
						$('#basic-info #coursetitle').val(jobData.title).prop('readonly', true);
						$('#basic-info #startdate').val(jobData.description).prop('readonly', true);
						$('#basic-info #enddate').val(jobData.department).prop('readonly', true);
						$('#basic-info #courselocation').val(jobData.dataAreaId).prop('readonly', true);
						$('#basic-info #description').val(jobData.hiringManager).prop('readonly', true);
						$('#basic-info #remarks').val(jobData.finalDate).prop('readonly', true);

						

					} else {
						alert("No Course data found.");
					}
				},
				error: function (xhr, status, error) {
					alert("Error: " + error);
					console.error(xhr.responseText);
				}
			});
		});


		//------------------------------------

			$(document).on('click', '#btnenrolle', function (e) {
			e.preventDefault();

			
			const Empid = $('#company').val();

			const payload = {
				
				Empid: Empid
			};

			$.ajax({
				url: '@Url.Action("CourseRegister", "Courses")',
				type: 'POST',
				data:(payload),

				dataType: 'json',                 

				success: function (response) {
					if (response.success) {
						alert(response.message || response.Message);
							window.location.href = '@Url.Action("ReadCoursesList ", "Courses")';
					} else {
						alert("Something went wrong: " + response.message);
					}
				},
				error: function (xhr, status, error) {
					alert("Error: " + error);
					console.error(xhr.responseText);
				}
			});
		});
</script>


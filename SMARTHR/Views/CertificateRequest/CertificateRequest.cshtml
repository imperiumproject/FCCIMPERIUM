									</td>
		

							

										@* 		<td>	</td><a href="#" class="me-2" data-bs-toggle="modal" data-bs-target="#Workflow_History" title="View"><i class="ti ti-eye"></i></a> *@
										@* 								<td><a href="#" class="me-2 btnWFView" id="btnWFView" name="btnWFView" data-bs-toggle="modal" data-bs-target="#Workflow_History" data-id="@item.CertificateId,@item.CertificateRecId,@item.WorkflowTableId" data-transtype="Certificate Request" title="View"><i class="ti ti-eye"></i></a></td> *@

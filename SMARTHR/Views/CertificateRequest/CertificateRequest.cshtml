<!-- Flatpickr CSS and JS -->
<link href="@Url.Content("~/assets/plugins/flatpickr/flatpickr.min.css")" rel="stylesheet" />
@section Scripts
{
	<script type="text/javascript">





					//--------------recallview

					$(document).on('click', '.btnRecall', function () {

					 var certificateid = $(this).data('id');

				// BindAttach();
				  var $modal = $('#add_certificate');
				   $('#btnUpdate').show()
				   $('#btnSave').hide()

				  // Step 1: Reset all form fields and clear Chosen dropdowns
		$modal.find('form')[0].reset();
		$modal.find('.chosen-select').val('').trigger('chosen:updated');
				   var certificateid = $(this).data('id'); // Get LeaveID from data-id attribute
				   //------------------
					// BindLeaveType();
				 //   BindBackupEmployee();

				   // Make AJAX call to ReadLeaveRequest
				   $.ajax({
					   url: '@Url.Action("ReadCertificateRequest", "CertificateRequest")',
					   type: 'GET',
					   data: { certificateid: certificateid }, // Use 'id' to match controller parameter
					   dataType: 'json',
					   success: function (response) {
						   // Check if leaveDetails exists and has items
						   if (response.certificateDetails && response.certificateDetails.length > 0) {
							   var leaveData = response.certificateDetails[0];

								 BindAllEmployee(leaveData.emplId);
								 BindAllCertificate(leaveData.type);
							   // Function to convert DD/MM/YYYY to YYYY-MM-DD
							   // function formatDate(inputDate) {
								  //  if (!inputDate) return '';
								  //  var parts = inputDate.split('/');
								  //  return `${parts[2]}-${parts[1]}-${parts[0]}`;
							   // }

							   // Populate modal fields with response data
							   $('#add_certificate #RequestId').val(leaveData.certificateId);

							   // $('#add_employee #transDate').val(leaveData.emplId).trigger("chosen:updated");


							   $('#add_certificate #transDate').val(leaveData.transDate);
							   // $('#add_employee #ddlEmployee').val(leaveData.);
							   $('#add_certificate #txtDesc').val(leaveData.description);
							   $('#add_certificate #wfComments').text(leaveData.wfComments);
							   // $('#add_employee #txttype').val(leaveData.leaveType).trigger("chosen:updated");
							   $('#add_certificate #txttype').val(leaveData.type);

								$('#add_certificate #leaveRecId').val(leaveData.certificateRecId);
							$('#add_certificate #requestTableId').val(leaveData.workflowTableId);
						var table = $('#attachmentsTable').DataTable();
							$('#countattach').text(leaveData.attachRefList.length);
							$.each(leaveData.attachRefList, function (i, item) {
								// Determine the MIME type (default to octet-stream if unknown)
								let mimeType = item.fileType || 'application/octet-stream';

								// Construct download link using base64
								let downloadLink = `<a href="data:${mimeType};base64,${item.attachRef}"
							download="${item.fileName}"
							target="_blank">${item.fileName}</a>`;

								table.row.add([
									downloadLink,
									item.attachedBy,
									formatDate(item.attachedDate),
									`<a href="#" data-bs-toggle="modal" data-bs-target="#delete_modal">
			<i class="ti ti-trash"></i>
		</a>`
								]).draw(false);
							});
									function formatDate(dateStr) {
			const d = new Date(dateStr);
			return d.toLocaleDateString("en-GB"); // dd/MM/yyyy
		}

						   } else {
							   alert('Error: No certificate details found in response');
						   }
					   },
					   error: function (xhr, status, error) {
						   alert('An error occurred while fetching the data: ' + error);
						   console.error('AJAX Error:', xhr.responseText); // Log response for debugging
					   }
				   });
					})


		//-------------------------Recall





			if (btncreateCRrequest) {
			btncreateCRrequest.addEventListener('click', function () {
			
				  $('#btnUpdate').hide();
				$('#btnSave').show();

				$('#transDate').val('');
				$('#txtDesc').val('');
				$('#wfComments').val('');
				// $('#leaveend').val('');
				fetchCertificateId();
				BindAllEmployee('');
				BindAllCertificate('');

			});
		} else {
			console.error('Create button (#btncreateCRrequest) not found');
		}




			//Generate Certificate Id
			async function fetchCertificateId() {
				const companyId = 'USMF';
				$.ajax({
					url: '/CertificateRequest/GetCertificateId',
					type: 'POST',
					contentType: 'application/json',
					data: JSON.stringify(companyId),
					success: function (data) {
						if (data !== "Error") {
							$('#RequestId').val(data);
						} else {
							alert("Failed to get Leave Id.");
						}
					},
					error: function (xhr, status, error) {
						console.error("Error fetching leave ID:", error);
						alert("Something went wrong while fetching the Leave ID.");
					}
				});
			}

				function BindAllEmployee(employeeIdToSelect)
		{

		function BindAttach() {
			var files = $("#attachments")[0].files;

			if (files.length === 0) {
				alert("Please select at least one file.");
				return;
			}

			var formData = new FormData();

			for (var i = 0; i < files.length; i++) {
				formData.append("Files", files[i]);
			}

			var uniqueRecID = $('#leaveRecId').val();
			var requestTableId = $('#requestTableId').val();

			formData.append("uniqueRecID", uniqueRecID);
			formData.append("RequestTableId", requestTableId);

			debugger;

			$.ajax({
				url: '/CertificateRequest/CreateAttachFile',
				type: 'POST',
				data: formData,
				processData: false,
				contentType: false,
				success: function (response) {
			if (response.success) {
				alert(response.message || "File uploaded successfully!");
			} else {
				alert("Upload failed. Please try again.");
			}
		}
			});
		}


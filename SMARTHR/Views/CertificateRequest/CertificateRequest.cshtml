		document.addEventListener('DOMContentLoaded', function () {
			let nextModalId = null;

			// Step 1: When a button is clicked, store the target modal ID
			document.querySelectorAll('.universal-modal-trigger').forEach(button => {
				button.addEventListener('click', function () {
					nextModalId = button.getAttribute('data-open-modal');
				});
			});

			// Step 2: On any modal hidden, check if we need to open another
			const allModals = document.querySelectorAll('.modal');
			allModals.forEach(modal => {
				modal.addEventListener('hidden.bs.modal', function () {
					if (nextModalId) {
						const nextModalEl = document.querySelector(nextModalId);
						if (nextModalEl) {
							const nextModal = new bootstrap.Modal(nextModalEl);
							nextModal.show();
						}
						nextModalId = null; // reset
					}
				});
			});
		});


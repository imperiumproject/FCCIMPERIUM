										<a href="#" class="me-2 btnWFView" id="btnWFView" name="btnWFView" data-bs-toggle="modal" data-bs-target="#Workflow_History" data-leaveid="@item.CertificateId" data-rec="@item.CertificateRecId" data-tableid="@item.requestTableId" data-transtype="Certificate Request" title="View"><i class="ti ti-eye"></i></a>
									</td>





								</tr>

							}


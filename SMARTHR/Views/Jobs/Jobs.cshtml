@section Scripts
{
<script>

	//----------------ViewJob
	            debugger;
				$(document).on('click', '.btnapply', function () {
			var description = $(this).data('id'); 

			$.ajax({
				url: '@Url.Action("ReadJobVacancyInfo", "Jobs")',
				type: 'POST',
				data: { description: description }, 
				dataType: 'json',
				success: function (response) {
					if (response.jobVacancyList && response.jobVacancyList.length > 0) {
						const jobData = response.jobVacancyList[0]; 

						$('#openjobs').val(jobData.openJobs).val();
						$('#basic-info #title').val(jobData.title).prop('readonly', true);
						$('#basic-info #description').val(jobData.description).prop('readonly', true);
						$('#basic-info #department').val(jobData.department).prop('readonly', true);
						$('#basic-info #company').val(jobData.dataAreaId).prop('readonly', true);
						$('#basic-info #hiringmanager').val(jobData.hiringManager).prop('readonly', true);
						$('#basic-info #applicationdeadline').val(jobData.finalDate).prop('readonly', true);

						// Certificate
						var certTable = $('#CertificateTable').DataTable();
						certTable.clear();
						if (jobData.certificateList && jobData.certificateList.length > 0) {
							$.each(jobData.certificateList, function (i, item) {
								certTable.row.add([
									item.type, 
									item.description, 
									item.importance]).draw(false);
							});
						}

						// Education
						var eduTable = $('#QualificationTable').DataTable();
						eduTable.clear();
						if (jobData.educationList && jobData.educationList.length > 0) {
							$.each(jobData.educationList, function (i, item) {
								eduTable.row.add([
									item.education,
									item.description, 
									item.importance]).draw(false);
							});
						}

						// Skills
						var skillTable = $('#SkillsTable').DataTable();
						skillTable.clear();
						if (jobData.skillList && jobData.skillList.length > 0) {
							$.each(jobData.skillList, function (i, item) {
								skillTable.row.add([item.skill,
									item.description, 
									item.ratingLevel || '',
									item.importance]).draw(false);
							});
						}

					} else {
						alert("No job data found.");
					}
				},
				error: function (xhr, status, error) {
					alert("Error: " + error);
					console.error(xhr.responseText);
				}
			});
		});



		//------------------------ApplyJob


				$(document).on('click', '#applybtn', function (e) {
			e.preventDefault();

			const jobDescription = $('#openjobs').val();
			const cmpid = $('#company').val();

			const payload = {
				jobDescription: jobDescription,
				cmpid: cmpid
			};

			$.ajax({
				url: '@Url.Action("ApplyForJob", "Jobs")',
				type: 'POST',
				data:(payload),
				
				dataType: 'json',                  // 👈 Expecting JSON response
				     
				success: function (response) {
					if (response.success) {
						alert(response.message || response.Message);
							window.location.href = '@Url.Action("ReadJobVacancyList ", "Jobs")';
					} else {
						alert("Something went wrong: " + response.message);
					}
				},
				error: function (xhr, status, error) {
					alert("Error: " + error);
					console.error(xhr.responseText);
				}
			});
		});




</script>
}


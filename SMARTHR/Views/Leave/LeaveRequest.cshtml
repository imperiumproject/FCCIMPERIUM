	$('#btnBTRecall').on('click', function (e) {
    e.preventDefault();
 
    // Get form values
    var leaveId = $('#leaveid').val();
    var RecordId = $('#workflowPermissionId').val();
    var TableId = $('#workflowTableId').val();
    var ReturnToLevel = $('#workflowlevelId').val();
    var TransType = 'Leave Request';
 
    // Optional: Validate inputs
    // if (!RecordId || !TableId || !ReturnToLevel) {
    //     alert('Please provide all required fields.');
    //     return;
    // }
 
    // AJAX call to RecallWorkflow
    $.ajax({
        url: '@Url.Action("RecallWorkflow", "BusinessTrip")',
        type: 'POST',
        data: {
            RecordId: RecordId,
            TableId: TableId,
            ReturnToLevel: ReturnToLevel,
            TransType: TransType
        },
        dataType: 'json',
        success: function (response) {
            if (response && (response.success === true || response.Success === true)) {
                alert(response.message || response.Message || "Recall successful!");
				 location.reload();
            } else {
                alert(response.message || response.Message || 'Recall failed.');
				 location.reload();
            }
        },
        error: function (xhr, status, error) {
            alert('An error occurred while recalling the workflow.');
            console.error('Error:', error);
            console.error('Response:', xhr.responseText);
        }
    });
})


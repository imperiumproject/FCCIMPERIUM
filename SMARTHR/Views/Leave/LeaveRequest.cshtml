@section Scripts
{

<script >
	document.addEventListener('DOMContentLoaded', () => {
		const cancelButton = document.getElementById('cancelLeaveButton');
		const btncreatenewrequest = document.getElementById('btncreatenewrequest');		
		if (cancelButton) {
			cancelButton.addEventListener('click', function () {				
				cancelLeaveRequest();
			});
		} else {
			console.error('Cancel button (#cancelLeaveButton) not found');
		}
		//Bind Data Leave
		if (btncreatenewrequest) {
			btncreatenewrequest.addEventListener('click', function () {
				  $('#btnUpdate').hide()
				$('#btnSave').show()
				$('#btnBTRecall').hide()
		  
				$('#leaveid').val('');
				$('#leavetype').val('');
				$('#leaveStart').val('');
				$('#leaveend').val('');
				fetchLeaveId();
				BindLeaveType("");
				BindBackupEmployee("");
				BindAllEmployee("");
			});
		} else {
			console.error('Create button (#btncreatenewrequest) not found');
		}
		

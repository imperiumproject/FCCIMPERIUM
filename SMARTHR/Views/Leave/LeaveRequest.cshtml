/// Cancel Leave Request

	async function cancelLeaveRequest() {
		const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
		const leaveNum = document.querySelector('#leaveNum')?.value || null;
		if (!token) {
			console.error('Anti-forgery token not found');
			alert('Error: Anti-forgery token missing');
			return;
		}
		const body = leaveNum ? { leaveNum: leaveNum } : {};

		try {
			const response = await fetch('/Leave/CancelleaveRequest', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'RequestVerificationToken': token
				},
				body: JSON.stringify(body)
			});
			// ... (rest of the function)
		} catch (error) {
			console.error('Error cancelling leave request:', error);
			alert('Failed to cancel leave request: ' + error.message);
		}
	}

	//Generate Leave Id
	async function fetchLeaveId() {
		const companyId = 'USMF';
		$.ajax({
			url: '/Leave/GetLeaveId',
			type: 'POST',
			contentType: 'application/json',
			data: JSON.stringify(companyId),
			success: function (data) {
				if (data !== "Error") {
					$('#leaveid').val(data);
				} else {
					alert("Failed to get Leave Id.");
				}
			},
			error: function (xhr, status, error) {
				console.error("Error fetching leave ID:", error);
				alert("Something went wrong while fetching the Leave ID.");
			}
		});
	}

	//Get No Of Days
	
	function GetNoOfDays(leavestart, leaveend, leavetype) {		
		const noOfDays = document.getElementById('noOfDays');
		const remainingLeave = document.getElementById('remainingLeave');
		const errorMessage = document.getElementById('errorMessage');
		var EmpId = $('#employeename').find('option:selected').val();
		// Clear previous values and show loading state
		noOfDays.value = 'Calculating...';
		remainingLeave.value = 'Calculating...';
		errorMessage.textContent = '';

		fetch('/Leave/GetNoOfDays', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json'
			},
			body: JSON.stringify({
				leavestart: leavestart,
				leaveend: leaveend,
				leavetype: leavetype,
				EmpId:EmpId
			})
		})
			.then(response => {
				console.log('Fetch response:', response);
				if (!response.ok) {
					return response.text().then(text => {
						throw new Error(text || `HTTP error! Status: ${response.status}`);
					});
				}
				return response.json();
			})
			.then(data => {
				debugger;
				console.log('Fetch data:', data);
				if (typeof data === 'string') {
					// Handle string error response (e.g., "Error: Invalid session data.")
					noOfDays.value = '';
					remainingLeave.value = '';
					errorMessage.textContent = data;
				} else if (data && data.noofDays !== undefined) {
					// Handle successful NoOfDaysVM response
					if (data.noofDays > 3 && leavetype=='Sick leave') {						
						noOfDays.value = '0';
						// remainingLeave.value = '0';
						
						var tempmsg =document.getElementById('tempmsg');
					    errorMessage.textContent = 'You cannot create sick leave more than 3 days. Please contact your line manager.';
						tempmsg.value = 1;
						return false;
					}		
					else{
						noOfDays.value = data.noofDays;
					}
					//remainingLeave.value = 'N/A'; // No remainingBalance in NoOfDaysVM
					errorMessage.textContent = data.message || ''; // Use message if available
				} else {
					noOfDays.value = '';
					remainingLeave.value = '';
					errorMessage.textContent = 'Failed to calculate leave details.';
				}
			})
			.catch(error => {
				console.error('Error fetching leave details:', error);
				noOfDays.value = '';
				remainingLeave.value = '';
				errorMessage.textContent = error.message || 'Something went wrong while fetching leave details.';
			});
	}
	


		// Global array to store file data
let attachRefList = [];

function BindAttachCreate() {
    return new Promise((resolve, reject) => {
        attachRefList = []; // Clear previous attachments
        const fileInput = $('#attachments')[0];
        const files = fileInput?.files;

        if (!fileInput || !files || files.length === 0) {
            resolve(); // No file input or no files selected, proceed with empty attachRefList
            return;
        }

        let processedFiles = 0;
        for (let i = 0; i < files.length; i++) {
            const file = files[i];
            // Optional: Validate file size and type (uncomment if needed)
            /*
            if (file.size > 5 * 1024 * 1024) { // Limit to 5MB
                reject('File ' + file.name + ' is too large. Maximum size is 5MB.');
                return;
            }
            if (!['application/pdf', 'image/jpeg', 'image/png'].includes(file.type)) {
                reject('File ' + file.name + ' is not a supported type (PDF, JPG, PNG).');
                return;
            }
            */

            const reader = new FileReader();
            reader.onload = function (e) {
                const base64String = e.target.result.split(',')[1]; // Extract Base64 string (remove data URI prefix)
                attachRefList.push({
                    fileName: file.name,
                    attachRef: base64String
                });

                processedFiles++;
                if (processedFiles === files.length) {
                    resolve(); // All files processed
                }
            };

            reader.onerror = function () {
                reject('Error reading file: ' + file.name);
            };

            reader.readAsDataURL(file); // Read file as Data URL to get Base64
        }
    });
}

$('#btnSave').on('click', function (e) {
    e.preventDefault(); // Prevent default form submission

    // Collect form data
      BindAttachCreate().then(() => {
        var leaveNums = $('#leaveid').val() || '';
        var EmployeeName = $('#employeename').val() || '';
        var leaveTypeText = $('#leavetype').find('option:selected').text() || '';
        var leaveStart = $('#leaveStart').val() || '';
        var leaveEnd = $('#leaveEnd').val() || '';
        var noOfDays = parseInt($('#noOfDays').val()) || 5;
        var payLeaveWithSalary = $('input[name="payLeaveWithSalary"]:checked').val();
        payLeaveWithSalary = payLeaveWithSalary === "true" ? true : payLeaveWithSalary === "false" ? false : null;
        var comments = $('#comments').val() || '';
        var userId = $('#employeename').find('option:selected').val() || '';
        var companyCode = null; // Set server-side from session
        var backupEmplyee = $('#backupemployee').find('option:selected').text() || '';
        var remainingLeave = parseInt($('#remainingLeave').val());
        var expectedDueDate = $('#expectedduedate').val() || '';
        var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
        var tempmsg = $('#tempmsg').val();

        // Debug: Log form data
        console.log('Form Data:', {
            LeaveNum: leaveNums,
            LeaveType: leaveTypeText,
            LeaveStart: leaveStart,
            LeaveEnd: leaveEnd,
            NoOfDays: noOfDays,
            PayLeaveWithSalary: payLeaveWithSalary,
            Comments: comments,
            UserId: userId,
            CompanyCode: companyCode,
            backupEmployee: backupEmplyee,
            Duedate: expectedDueDate,
            AttachRefList: attachRefList,
            __RequestVerificationToken: antiForgeryToken
        });

        // Basic client-side validation
        if (!leaveTypeText || leaveTypeText === 'Select') {
            $('#errorMessage').html('<p style="color: red;">Please select a valid leave type.</p>');
            $('#leavetype').focus();
            return false;
        }
        if (!leaveStart || !leaveEnd) {
            $('#errorMessage').html('<p style="color: red;">Please provide valid start and end dates.</p>');
            $('#leaveStart').focus();
            return false;
        }
        // if (backupEmplyee === 'Select' || backupEmplyee === '') {
        //     $('#errorMessage').html('<p style="color: red;">Please select backup employee</p>');
        //     $('#backupemployee').focus();
        //     return false;
        // }
        if (!noOfDays || noOfDays <= 0) {
            $('#errorMessage').html('<p style="color: red;">Please provide a valid number of days.</p>');
            $('#noOfDays').focus();
            return false;
        }
        if (!remainingLeave || remainingLeave <= 0 || remainingLeave < noOfDays) {
            $('#errorMessage').html('<p style="color: red;">You can not apply leave because your leave balance is 0 or more than leave balance.</p>');
            $('#remainingLeave').focus();
            return false;
        }
        // if (leaveTypeText.includes('AL') && payLeaveWithSalary == null) {
        //     $('#errorMessage').html('<p style="color: red;">Please select whether to pay leave with salary.</p>');
        //     return false;
        // }
        if (leaveTypeText === 'Maternity leave' && expectedDueDate === '') {
            $('#errorMessage').html('<p style="color: red;">Expected due date must be select.</p>');
            $('#expectedduedate').focus();
            return false;
        } 
		if (leaveTypeText === 'AL ' && expectedDueDate === '') {
            $('#errorMessage').html('<p style="color: red;">Expected due date must be select.</p>');
            $('#expectedduedate').focus();
            return false;
        }
        if (tempmsg == 1) {
            return false;
        }

        // Prepare JSON payload
        var payload = {
            leaveContract: {
              	    LeaveNum: leaveNums,
					LeaveType: leaveTypeText,
					    LeaveStart: leaveStart,
					    LeaveEnd: leaveEnd,
					    NoOfDays: noOfDays,
					    PayLeaveWithSalary: payLeaveWithSalary,
					    Comments: comments,
					    UserId: userId,
					    CompanyCode: companyCode,
						backupEmployee:backupEmplyee,
						Duedate:expectedDueDate,
						RaisedBy:userId,
                attachRefList: attachRefList // Always include, empty if no files
            }
        };

        // Make AJAX request
        $.ajax({
            url: '/Leave/CreateLeaveRequest',
            type: 'POST',
            data: JSON.stringify(payload),
            contentType: 'application/json',
            headers: {
                'RequestVerificationToken': antiForgeryToken
            },
            beforeSend: function () {
                $('#btnSave').prop('disabled', true).text('Submitting...');
            },
            success: function (response) {
                if (response.messageFlag !== 'Failed') {
                    $('#success_modal .modal-body h5').text('Leave Request Created Successfully');
                    $('#success_modal .modal-body p').html(
                        `${EmployeeName} has been scheduled for a Leave Request with Request ID: <span class="text-primary">${leaveNums || '#TRIP-0001'}</span>`
                    );
                    $('#success_modal').modal('show');
					 $('#btnSave').prop('disabled', false).text('Submit');
                    var successMessage = (response.Message || response.message || 'Leave request saved successfully!');
                    $('#errorMessage').html('<p style="color: green;">' + successMessage + '</p>');
                    $('#leaveRequestForm')[0].reset();
                    attachRefList = []; // Clear attachments after successful submission
                    $('#fileList').html('No files selected.'); // Clear file list display
                } else {
                    var successMessage = (response.Message || response.message);
                    $('#errorMessage').html('<p style="color: red;">' + successMessage + '</p>');
					 $('#btnSave').prop('disabled', false).text('Submit');
                }
            },
            error: function (xhr) {
                var errorMessage = 'An error occurred while saving the request.';
                if (xhr.responseJSON) {
                    errorMessage = xhr.responseJSON.message || xhr.responseJSON.Message || errorMessage;
                } else if (xhr.statusText) {
                    errorMessage = xhr.statusText;
                }
                $('#errorMessage').html('<p style="color: red;">' + errorMessage + '</p>');
            },
            complete: function () {
                $('#btnSave').prop('disabled', false).text('Submit');
            }
        });
    }).catch(error => {
        $('#errorMessage').html('<p style="color: red;">' + error + '</p>');
        $('#btnSave').prop('disabled', false).text('Submit');
    });
});


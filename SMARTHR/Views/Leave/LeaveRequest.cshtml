@model List<SMARTHR.WEB.Models.LeaveDetails>
@{
    ViewData["Title"] = "LeaveRequest";
	@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
}


<div class="content">

	<!-- Breadcrumb -->
	<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
		<div class="my-auto mb-2">
			<h2 class="mb-1">Request</h2>
			<nav>
				<ol class="breadcrumb mb-0">
					<li class="breadcrumb-item">
						<a href="index.html"><i class="ti ti-smart-home"></i></a>
					</li>
					<li class="breadcrumb-item">
						Payroll
					</li>
					<li class="breadcrumb-item active" aria-current="page">Leave Request List</li>
				</ol>
			</nav>
		</div>
		<div class="d-flex my-xl-auto right-content align-items-center flex-wrap ">

			<div class="mb-2">
				<a href="#" data-bs-toggle="modal" id="btncreatenewrequest" data-bs-target="#add_employee" class="btn btn-primary d-flex align-items-center"><i class="ti ti-circle-plus me-2"></i>Create New</a>
			</div>

		</div>
	</div>
	<!-- /Breadcrumb -->
	<!-- /Breadcrumb -->



	<div class="card">

		<div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
			<h5>Leave Request List</h5>
			<div class="d-flex my-xl-auto right-content align-items-center flex-wrap row-gap-3">

				<div class="dropdown me-3">
					<a href="javascript:void(0);" class="dropdown-toggle btn btn-white d-inline-flex align-items-center" data-bs-toggle="dropdown">
						Employee
					</a>
					<ul class="dropdown-menu  dropdown-menu-end p-3">
						<li>
							<a href="javascript:void(0);" class="dropdown-item rounded-1">Finance</a>
						</li>
						<li>
							<a href="javascript:void(0);" class="dropdown-item rounded-1">Developer</a>
						</li>
						<li>
							<a href="javascript:void(0);" class="dropdown-item rounded-1">Executive</a>
						</li>
					</ul>
				</div>
				<div class="dropdown me-3">
					<a href="javascript:void(0);" class="dropdown-toggle btn btn-white d-inline-flex align-items-center" data-bs-toggle="dropdown">
						Select Status
					</a>
					<ul class="dropdown-menu  dropdown-menu-end p-3">
						<li>
							<a href="javascript:void(0);" class="dropdown-item rounded-1">Active</a>
						</li>
						<li>
							<a href="javascript:void(0);" class="dropdown-item rounded-1">Inactive</a>
						</li>
					</ul>
				</div>
				<button class="btn  bg-primary btn-wave waves-effect waves-light">
					<i class="feather-download align-middle me-2 d-inline-block"></i>Search
				</button>

			</div>
		</div>
		<div class="card-body p-0">
			<div class="custom-datatable-filter table-responsive">
				<table class="table datatable">
					<thead class="thead-light">
						<tr>
							<th>Request ID</th>
							<th>Employee Name</th>
							<th>Leave Type</th>
							<th>From Date</th>
							<th>To Date</th>
							<th>Status</th>
							<th>Actions</th>
							<th>Workflow History</th>
						</tr>
					</thead>
					<tbody>
						@if (Model != null && Model.Any())
						{
							foreach (var item in Model)
							{
							 <tr>
								<td><a href="@Url.Action("Details", "Leave", new { id = item.LeaveID })">@item.LeaveID</a></td>
								<td>@item.EmplId-@item.employeeName</td>
								<td>@item.LeaveType</td>
								<td>
								@{
								    string leaveStartFormatted = "";
								    if (!string.IsNullOrWhiteSpace(item.LeaveStart))
								    {
								        DateTime tempDate;
								        if (DateTime.TryParseExact(item.LeaveStart, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out tempDate))
								        {
								            leaveStartFormatted = tempDate.ToString("dd/MM/yyyy");
								        }
								    }
								}
								@leaveStartFormatted
								</td>

								<td>
								    @{
								        string leaveEndFormatted = "";
								        if (!string.IsNullOrWhiteSpace(item.LeaveEnd))
								        {
								            DateTime tempDate;
								            if (DateTime.TryParseExact(item.LeaveEnd, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out tempDate))
								            {
								                leaveEndFormatted = tempDate.ToString("dd/MM/yyyy");
								            }
								        }
								    }
								    @leaveEndFormatted
								</td>
							@* 	<td>@Convert.ToDateTime(item.LeaveStart).ToString("dd/MM/yyyy")</td>
								<td>@Convert.ToDateTime(item.LeaveEnd).ToString("dd/MM/yyyy")</td> *@
								<td>
								    <span class="badge @(item.Status == "Draft" ? "badge-danger" : "badge-success") d-inline-flex align-items-center badge-xs">
								        <i class="ti ti-point-filled me-1"></i>@item.Status
								    </span>
								</td>
								<td>
								    <div class="action-icon d-inline-flex">
										@if(item.Status=="Approved"){
										@* <a href="#" class="me-2 btnRecall" id="btnRecall" name="btnRecall" data-bs-toggle="modal" data-id="@item.LeaveID" data-bs-target="#add_employee"><i class="ti ti-history" title="Recall"></i></a> *@

											 <a class="me-2 btnView" id="btnView" disabled name="btnView" data-id="@item.LeaveID" data-bs-toggle="modal" data-bs-target="#add_employee"><i class="ti ti-eye"></i></a>
											@* <a class="me-2 btnDelete disabled" disabled data-bs-target="#delete_modal" id="btnDelete" name="btnDelete" data-id="@item.LeaveID"><i class="ti ti-trash"></i></a> *@
										}
										else if ((item.Status ?? "").ToUpper() == "DRAFT")
										{
                                             <a class="me-2 btnView" id="btnView" name="btnView" data-id="@item.LeaveID" data-bs-toggle="modal" data-bs-target="#add_employee"><i class="ti ti-eye"></i></a>
											 <a class="me-2 btnDelete" data-bs-target="#delete_modal" id="btnDelete" name="btnDelete" data-id="@item.LeaveID"><i class="ti ti-trash"></i></a>
										}
										else{
										     <a href="#" class="me-2 btnRecall" id="btnRecall" name="btnRecall" data-bs-toggle="modal" data-id="@item.LeaveID" data-bs-target="#add_employee"><i class="ti ti-history" title="Recall"></i></a>
											 <a class="me-2 btnView" id="btnView" name="btnView" data-id="@item.LeaveID" data-bs-toggle="modal" data-bs-target="#add_employee"><i class="ti ti-eye"></i></a>
											@*  <a class="me-2 btnDelete" data-bs-target="#delete_modal" id="btnDelete" name="btnDelete" data-id="@item.LeaveID"><i class="ti ti-trash"></i></a> *@
										}
								     
								    </div>
								</td>
								@* <td><a href="@Url.Action("WorkflowHistory", "Leave", new { id = item.LeaveID })">View</a></td> *@
								<td><a href="#" class="me-2 btnWFView" id="btnWFView" name="btnWFView" data-bs-toggle="modal" data-bs-target="#Workflow_History" data-leaveid="@item.LeaveID"
                                data-rec="@item.LeaveRecId"data-tableid="@item.requestTableId"data-transtype="Leave Request" title="View"><i class="ti ti-eye"></i></a></td>
							</tr>
							}						
						}
						else{
							<tr>
								<th></th>
							<th></th>
							<th></th>
							<th></th>
							<th></th>
							<th></th>
							<th></th>
							</tr>
							
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

</div>

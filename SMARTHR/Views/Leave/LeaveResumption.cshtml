<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="@Url.Content("~/assets/plugins/flatpickr/flatpickr.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/assets/plugins/flatpickr/flatpickr.min.js")"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script type="text/javascript">
	$(document).ready(function () {

		flatpickr("#returndate", {
			dateFormat: "d/m/Y", // Flatpickr uses lowercase m/d/Y for MM/dd/yyyy
			allowInput: true
		});
		

		$(document).on('click', '.btnView', function () {
			var leaveId = $(this).data('id');

			var $modal = $('#add_employee');
			// Step 1: Reset all form fields and clear Chosen dropdowns
			$modal.find('form')[0].reset();
			$modal.find('.chosen-select').val('').trigger('chosen:updated');
			var leaveId = $(this).data('id'); // Get LeaveID from data-id attribute

			$.ajax({
				url: '@Url.Action("ReadLeaveResumption", "Leave")',
				type: 'GET',
				data: { leaveId: leaveId }, // Use 'id' to match controller parameter
				dataType: 'json',
				success: function (response) {
					// Check if leaveDetails exists and has items
					if (response.leaveDetails && response.leaveDetails.length > 0) {
						var leaveData = response.leaveDetails[0];

						// Function to convert DD/MM/YYYY to YYYY-MM-DD 
						function formatDate(inputDate) {
							if (!inputDate) return '';
							var parts = inputDate.split('/');
							return `${parts[2]}-${parts[1]}-${parts[0]}`;
						}

						// Populate modal fields with response data
						$('#add_employee #leaveid').val(leaveData.leaveID);
						$('#add_employee #employeename').val(leaveData.emplId + ' - ' + leaveData.employeeName);
						$('#add_employee #leavetype').val(leaveData.leaveType);
						if (leaveData.leaveType == 'Maternity leave') {
							$('#add_employee #divexpecteddeliverydate').show('show');
						}
						else {
							$('#add_employee #divexpecteddeliverydate').hide('hide');
						}
						$('#add_employee #fromdate').val(formatDate(leaveData.leaveStart));
						$('#add_employee #todate').val(formatDate(leaveData.leaveEnd));
						$('#add_employee #returndate').val(formatDate(leaveData.returnDate));
					if (leaveData.status.toUpperCase() === "SUBMITTED") {
    $('#add_employee #returndate')
        .prop('readonly', true)
        .css('pointer-events', 'none');
					}
						

						$('#add_employee #leavebalance').val(leaveData.leaveBalance);
						$('#add_employee #noofdays').val(leaveData.noOfDays);
						/* $('#add_employee #payLeaveWithSalary').prop('checked', leaveData.payleavewithSalary == 'Yes'); */
						if (leaveData.payleavewithSalary === true || leaveData.payleavewithSalary === "true") {
							$('#add_employee #payLeaveWithSalaryYes').prop('checked', true).prop('readonly', true).css('pointer-events', 'none');
						} else if (leaveData.payleavewithSalary === false || leaveData.payleavewithSalary === "false") {
							$('#add_employee #payLeaveWithSalaryNo').prop('checked', true).prop('readonly', true).css('pointer-events', 'none');
						} else {
							//Optionally uncheck both if the value is invalid
							$('#add_employee input[name="payLeaveWithSalary"]').prop('checked', false).prop('readonly', true).css('pointer-events', 'none');
						} // Checkbox
						$('#add_employee #backupemployee').val(leaveData.backupEmployee || 'Not Available');
						$('#add_employee #expecteddeliverydate').val()
						//$('#add_employee #noofattachments').val(leaveData.attachRefList.length); // Use attachRefList length
						$('#add_employee #comments').val(leaveData.Msg || 'missing'); // Use Msg or fallback to 'missing'
						
						if (leaveData.leaveType.includes('AL')) {
							$('#add_employee #payleavewithsalarylable').show('show');
							$('#add_employee #payLeaveWithSalaryYes').prop('checked', true);
						}
						else {
							$('#add_employee #payleavewithsalarylable').hide('hide');
						}
					} else {
						alert('Error: No leave details found in response');
					}
				},
				error: function (xhr, status, error) {
					alert('An error occurred while fetching the data: ' + error);
					console.error('AJAX Error:', xhr.responseText); // Log response for debugging
				}
			});
		});

		//--------------------------------------------------------------------------------

		// Global array to store file data
		let attachRefList = [];

		function BindAttachCreate() {
			return new Promise((resolve, reject) => {
				attachRefList = []; // Clear previous attachments
				const fileInput = $('#attachments')[0];
				const files = fileInput?.files;

				if (!fileInput || !files || files.length === 0) {
					resolve(); // No file input or no files selected, proceed with empty attachRefList
					return;
				}

				let processedFiles = 0;
				for (let i = 0; i < files.length; i++) {
					const file = files[i];
					// Optional: Validate file size and type (uncomment if needed)
					/*
					if (file.size > 5 * 1024 * 1024) { // Limit to 5MB
						reject('File ' + file.name + ' is too large. Maximum size is 5MB.');
						return;
					}
					if (!['application/pdf', 'image/jpeg', 'image/png'].includes(file.type)) {
						reject('File ' + file.name + ' is not a supported type (PDF, JPG, PNG).');
						return;
					}
					*/

					const reader = new FileReader();
					reader.onload = function (e) {
						const base64String = e.target.result.split(',')[1]; // Extract Base64 string (remove data URI prefix)
						attachRefList.push({
							fileName: file.name,
							attachRef: base64String
						});

						processedFiles++;
						if (processedFiles === files.length) {
							resolve(); // All files processed
						}
					};

					reader.onerror = function () {
						reject('Error reading file: ' + file.name);
					};

					reader.readAsDataURL(file); // Read file as Data URL to get Base64
				}
			});
		}

		$('#btnSubmit').on('click', function (e) {
			e.preventDefault(); // Prevent default form submission
			BindAttachCreate().then(() => { 
			// Collect form data
			var leaveID = $('#leaveid').val() || '';
			var requestType = 'Update';
			var returnDate = $('#returndate').val() || '';
			var wfComments = $('#comments').val() || '';
			var companyCode = null; // Adjust if companyCode is available


			// Get Anti-Forgery Token
			var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

			// Debug: Log form data
			console.log('Form Data:', {
				leaveID: leaveID,
				requestType: requestType,
				returnDate: returnDate,
				wfComments: wfComments,
				companyCode: companyCode,
				__RequestVerificationToken: antiForgeryToken
			});

			// Validate required fields
			if (!leaveID || !returnDate) {
				$('#success_modal .modal-body .avatar').removeClass('bg-success bg-danger').addClass('bg-danger').html('<i class="ti ti-x fs-24"></i>');
				$('#success_modal .modal-body h5').text('Validation Error');
				$('#success_modal .modal-body p').html('Please fill in all required fields (Leave ID and Return Date).');
				$('#success_modal .modal-footer').hide(); // Hide buttons
				$('#success_modal').modal('show');
				return;
			}

			// Prepare JSON payload
			var payload = {
				readUpdateLeave: {
					leaveID: leaveID,
					returnDate: returnDate,
					requestType: requestType,
					wfComments: wfComments,
					CompanyCode: companyCode,
						attachRefList: attachRefList
				}
			};

			// Make AJAX request
			$.ajax({
				url: '/Leave/UpdateLeaveResumptionRequest',
				type: 'POST',
				data: JSON.stringify(payload),
				contentType: 'application/json',
				headers: {
					'RequestVerificationToken': antiForgeryToken
				},
				beforeSend: function () {
					$('#btnSubmit').prop('disabled', true).text('Submit...');
				},
				success: function (response) {
					debugger;
					console.log('Server Response:', response);
					if (response && response.leaveMsgDetails && Array.isArray(response.leaveMsgDetails) && response.leaveMsgDetails.length > 0 && response.leaveMsgDetails[0].message) {
						var message = response.leaveMsgDetails[0].message;
						var isSuccess = response.leaveMsgDetails[0].messageFlag && response.leaveMsgDetails[0].messageFlag.toLowerCase() !== 'failed';

						var iconClass = isSuccess ? 'bg-success' : 'bg-danger';
						var icon = isSuccess ? '<i class="ti ti-check fs-24"></i>' : '<i class="ti ti-x fs-24"></i>';
						var title = isSuccess ? 'Success' : 'Error';

						// Update modal content
						$('#success_modal .modal-body .avatar').removeClass('bg-success bg-danger').addClass(iconClass).html(icon);
						$('#success_modal .modal-body h5').text(title);
						$('#success_modal .modal-body p').html(message);
						$('#success_modal .modal-footer').hide(); // Hide buttons if not needed

						// Show the modal
						$('#success_modal').modal('show');

						if (isSuccess) {
							$('#leaveRequestForm')[0].reset();
							setTimeout(function () {
								$('#add_employee').modal('hide');
								$('#success_modal').modal('hide');
							}, 2000);
						}
					} else {
						// Show error in modal
						$('#success_modal .modal-body .avatar').removeClass('bg-success bg-danger').addClass('bg-danger').html('<i class="ti ti-x fs-24"></i>');
						$('#success_modal .modal-body h5').text('Error');
						$('#success_modal .modal-body p').html('Invalid response format from server.');
						$('#success_modal .modal-footer').hide();
						$('#success_modal').modal('show');
						console.error('Invalid response structure:', response);
					}
				},
				error: function (xhr) {
					debugger;
					console.error('AJAX Error Details:', {
						status: xhr.status,
						statusText: xhr.statusText,
						responseJSON: xhr.responseJSON,
						responseText: xhr.responseText
					});
					var errorMessage = 'An error occurred while saving the request.';
					if (xhr.responseJSON && xhr.responseJSON.leaveMsgDetails && Array.isArray(xhr.responseJSON.leaveMsgDetails) && xhr.responseJSON.leaveMsgDetails.length > 0 && xhr.responseJSON.leaveMsgDetails[0].message) {
						errorMessage = xhr.responseJSON.leaveMsgDetails[0].Msg;
					} else if (xhr.responseJSON && xhr.responseJSON.message) {
						errorMessage = xhr.responseJSON.message;
					} else if (xhr.statusText) {
						errorMessage = xhr.statusText;
					}

					// Update modal content
					$('#success_modal .modal-body .avatar').removeClass('bg-success bg-danger').addClass('bg-danger').html('<i class="ti ti-x fs-24"></i>');
					$('#success_modal .modal-body h5').text('Error');
					$('#success_modal .modal-body p').html(errorMessage);
					$('#success_modal .modal-footer').hide();
					$('#success_modal').modal('show');
				},
				complete: function () {
					$('#btnSubmit').prop('disabled', false).text('Submit');
				}

				});
			});
		});



		const row = button.closest('tr');
		const inputs = row.querySelectorAll('input, select');
		const values = [];

		inputs.forEach(input => {
			values.push(input.value || "-");
		});

		row.innerHTML = `
		<td>${values[0]}</td>
		<td>${values[1]}</td>
		<td>${values[2]}</td>
		<td>${values[3]}</td>
		<td>${values[4]}</td>
		<td>
		<button class="btn btn-warning btn-sm me-1" onclick="editRow(this)">Edit</button>
		<button class="btn btn-danger btn-sm" onclick="deleteRow(this)">Delete</button>
		</td>
			  `;
	}

	function editRow(button) {
		const row = button.closest('tr');
		const tds = row.querySelectorAll('td');
		const currentValues = Array.from(tds).slice(0, 5).map(td => td.textContent.trim());

		row.innerHTML = `
		<td>
		<select class="form-control">
		<option value="Travel" ${currentValues[0] === 'Travel' ? 'selected' : ''}>Travel</option>
		<option value="Food" ${currentValues[0] === 'Food' ? 'selected' : ''}>Food</option>
		<option value="Accommodation" ${currentValues[0] === 'Accommodation' ? 'selected' : ''}>Accommodation</option>
		<option value="Other" ${currentValues[0] === 'Other' ? 'selected' : ''}>Other</option>
		</select>
		</td>
		<td><input type="text" class="form-control" value="${currentValues[1]}"></td>
		<td><input type="number" class="form-control" value="${currentValues[2]}"></td>
		<td><input type="number" class="form-control" value="${currentValues[3]}"></td>
		<td><input type="text" class="form-control" value="${currentValues[4]}"></td>
		<td>
		<button class="btn btn-primary btn-sm me-1" onclick="saveRow(this)">Save</button>
		<button class="btn btn-danger btn-sm" onclick="deleteRow(this)">Delete</button>
		</td>
			  `;
	}

	function deleteRow(button) {
		const row = button.closest('tr');
		row.remove();
	}

	



	// Function to populate loan items table
	function populateLoanItemsTable(table, loanItems, countElement) {
		console.log('Populating loan items table with data:', loanItems);
		table.clear();
		$(countElement).text(loanItems?.length || 0);

		if (loanItems && Array.isArray(loanItems) && loanItems.length > 0) {
			$.each(loanItems, function (i, item) {
				console.log('Processing loan item:', item);
				if (!item.Id || !item.loantype) {
					console.warn(`Invalid loan item at index ${i}:`, item);
					return true; // Skip invalid item
				}

				const radioName = `loanStatus_${item.Id}_${i}`;
				const statusHtml = `
						<div class="d-flex align-items-center">
							<div class="form-check me-2">
								<input class="form-check-input" type="radio" name="${radioName}" value="Yes" id="loanYes_${item.Id}_${i}" ${item.loanItemid === 'Yes' ? 'checked' : ''}>
								<label class="form-check-label" for="loanYes_${item.Id}_${i}">Yes</label>
							</div>
							<div class="form-check me-2">
								<input class="form-check-input" type="radio" name="${radioName}" value="No" id="loanNo_${item.Id}_${i}" ${item.loanItemid === 'No' ? 'checked' : ''}>
								<label class="form-check-label" for="loanNo_${item.Id}_${i}">No</label>
							</div>
						</div>`;

				table.row.add([
					`<a href="#">${item.Id}</a>`,
					item.loantype || '',
					statusHtml
				]).draw(false);
			});
		} else {
			console.log('No loan items to display');
			table.draw();
		}
	}


</script>
					if (employeeIdToSelect) {
						$select.val(employeeIdToSelect).trigger('change.select2');
					}
				},
				error: function (xhr, status, error) {
					$('.loading').remove();
					console.error('AJAX error:', status, error, xhr.responseText);
					var errorDiv = $('<div class="alert alert-danger mt-3"></div>').text('An error occurred while loading employee data: ' + (xhr.responseText || error));

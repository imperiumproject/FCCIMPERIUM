					$('.loading').remove();
					console.log('AJAX response:', JSON.stringify(response, null, 2));

					let employeeList = null;
					if (Array.isArray(response)) {
						employeeList = response;
					} else if (response && response.EmployeeList && Array.isArray(response.EmployeeList)) {
						employeeList = response.EmployeeList;
					} else if (response && response.data && Array.isArray(response.data)) {
						employeeList = response.data;
					}

					var $select = $('#myTabContent3 #delemployeename');
					$select.empty().append('<option value="">Select</option>');

					if (employeeList && employeeList.length > 0) {
						$.each(employeeList, function (index, item) {
							$select.append($('<option>', {
								value: item.employeeId,
								text: item.employeeName
							}));
						});
					} else {
						console.log('No employees found in response:', JSON.stringify(response, null, 2));
						$select.append('<option value="" disabled>No employees available</option>');
					}

					// Destroy existing Select2 instance to prevent re-initialization issues
					if ($select.data('select2')) {
						$select.select2('destroy');
					}

					// Initialize Select2 for delemployeename with search enabled
					$select.select2({
						dropdownParent: $('#myTabContent3 #Delegation_modal'),
						minimumResultsForSearch: 1 // Enable search box even with one option
					});


    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const content = document.getElementById('content');
            const isActive = sidebar.classList.contains('active');
            sidebar.classList.toggle('active', !isActive);
            content.classList.toggle('active', !isActive);
            localStorage.setItem('sidebarState', isActive ? 'closed' : 'open');
        }

        function toggleSubmenu(event, element) {
            event.preventDefault();
            const submenu = element.nextElementSibling;
            const menuId = element.getAttribute('data-id');
            if (!submenu || !submenu.classList.contains('submenu')) return;
            submenu.classList.toggle('active');
            element.classList.toggle('expanded');
            const openedSubmenus = JSON.parse(localStorage.getItem('openedSubmenus') || '[]');
            const index = openedSubmenus.indexOf(menuId);
            if (submenu.classList.contains('active')) {
                if (index === -1) openedSubmenus.push(menuId);
            } else {
                if (index > -1) openedSubmenus.splice(index, 1);
            }
            localStorage.setItem('openedSubmenus', JSON.stringify(openedSubmenus));
        }

        document.addEventListener('DOMContentLoaded', () => {
            const sidebarState = localStorage.getItem('sidebarState');
            const sidebar = document.getElementById('sidebar');
            const content = document.getElementById('content');
            if (sidebarState === 'open') {
                sidebar.classList.add('active');
                content.classList.add('active');
            }

            const openedSubmenus = JSON.parse(localStorage.getItem('openedSubmenus') || '[]');
            openedSubmenus.forEach(id => {
                const menuItem = document.querySelector(`.menu-item[data-id="${id}"]`);
                if (menuItem) {
                    const submenu = menuItem.nextElementSibling;
                    if (submenu) {
                        submenu.classList.add('active');
                        menuItem.classList.add('expanded');
                    }
                }
            });

            const currentUrl = window.location.pathname.toLowerCase();
            document.querySelectorAll('.submenu .menu-item').forEach(link => {
                if (link.getAttribute('href').toLowerCase() === currentUrl) {
                    link.classList.add('active');
                    const parent = link.closest('.submenu');
                    if (parent) {
                        parent.classList.add('active');
                        const toggleLink = parent.previousElementSibling;
                        if (toggleLink && toggleLink.classList.contains('menu-item')) {
                            toggleLink.classList.add('expanded');
                        }
                    }
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
 *@








    <script>
        $(document).ready(function () {

            $(".chosen-select").chosen({

                allow_single_deselect: true,
                width: "100%"
            })
        })
        // $('#add_employee').on('.ti ti - x', function () {
        //     location.reload(); // This will reload the entire page
        // });
        $('.btn-close').on('click', function () {
            location.reload(); // This will reload the entire page
        });
        $('#cancelLeaveButton').on('click', function () {
            location.reload(); // This will reload the entire page
        });
        flatpickr(".datepicker", {
            dateFormat: "d/m/Y", // Flatpickr uses lowercase m/d/Y for MM/dd/yyyy
            allowInput: true
        });

        $(document).on('click', '.btnWFView', function (e) {
            e.preventDefault(); // Prevent default link behavior

           //  // Parse data-id (e.g., "123,456,789" into [LeaveID, LeaveRecId, WorkflowTableId])
           //  var idData = $(this).data('id').split(',');
           //  if (idData.length < 3) {
           //      alert('Invalid data-id format');
           //      return;
           //  }
           //  var leaveId = idData[0] || '';
           //  var leaveRecId = idData[1] || ''; // Not used in AJAX, but kept for potential future use
           //  var workflowTableId = idData[2] || '';
           // // var TransType = 'Leave Request';
           // var TransType =idData[3] || '' ;
           var leaveId = $(this).data('leaveid') || '';
            var leaveRecId = $(this).data('rec') || ''; // Not used in AJAX, but kept for potential future use
            var workflowTableId = $(this).data('tableid')|| '';
           // var TransType = 'Leave Request';
           var TransType =$(this).data('transtype') || '' ;
            $.ajax({
                url: '@Url.Action("TrackRequestWorkFlow", "Leave")',
                type: 'GET',
                data: {
                    RecordId: leaveRecId,
                    TableId: workflowTableId,
                    TransType: TransType
                },
                dataType: 'json',
                success: function (response) {
                    if (response.wfTrackingList && response.wfTrackingList.length > 0) {
                        var firstEntry = response.wfTrackingList[0];

                        // Clear previous content
                        $('#workflowContainer').empty();

                        // Create table element
                        var $table = $('<table class="table table-bordered table-striped datatable"></table>');

                        // Create thead
                        var $thead = $('<thead class="thead-light"></thead>');
                        var $headerRow = $('<tr></tr>');
                        $headerRow.append('<th>Level</th>');
                        $headerRow.append('<th>Approver</th>');
                        $headerRow.append('<th>Status</th>');
                        $headerRow.append('<th>Remarks</th>');
                        $headerRow.append('<th>Comments</th>');
                        $headerRow.append('<th>Date</th>');
                        $thead.append($headerRow);

                        // Create tbody
                        var $tbody = $('<tbody></tbody>');
                        $.each(response.wfTrackingList, function (index, entry) {
                            var $row = $('<tr></tr>');
                            $row.append('<td>' + (entry.levelName || '') + '</td>');
                            $row.append('<td>' + (entry.employeeName || '') + '</td>');
                            $row.append('<td>' + (entry.status || '') + '</td>');
                            $row.append('<td>' + (entry.remarks || '') + '</td>');
                            $row.append('<td>' + (entry.comments || '') + '</td>');
                            $row.append('<td>' + (entry.transDate || '') + '</td>');
                            $tbody.append($row);
                        });

                        // Append thead and tbody to table
                        $table.append($thead).append($tbody);

                        // Optional title block
                        var $titleBlock = $('<div class="mb-2 fw-bold">WF Trans ID: ' + (firstEntry.wFTransID || '') +
                            ' | Employee ID: ' + (firstEntry.raisedBy || '') + '</div>');

                        // Append everything to container div
                        $('#workflowContainer').append($titleBlock).append($table);

                        // Initialize DataTable (if needed)
                        if ($.fn.DataTable) {
                            $table.DataTable({
                                // paging: false,
                                // searching: false,
                                // info: false
                                order: []
                            });
                        }
                    } else {
                        $('#workflowContainer').html('<div class="alert alert-warning">No workflow details found.</div>');
                    }
                },
                error: function (xhr, status, error) {
                    $('#workflowContainer').html('<div class="alert alert-danger">Error loading workflow data: ' + error + '</div>');
                    console.error('AJAX Error:', xhr.responseText);
                }
            });

        });

    </script>

    @RenderSection("Scripts", required: false)
</body>



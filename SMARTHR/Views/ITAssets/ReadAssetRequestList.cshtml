@model List<SMARTHR.WEB.Models.ITAssetsModels>
@{
    ViewData["Title"] = "ReadAssetRequestList";
}

<!-- Page Wrapper -->
@* <div class="page-wrapper"> *@
	<div class="content">

		<!-- Breadcrumb -->
		<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
			<div class="my-auto mb-2">
				<h2 class="mb-1">Request</h2>
				<nav>
					<ol class="breadcrumb mb-0">
						<li class="breadcrumb-item">
							<a href="index.html"><i class="ti ti-smart-home"></i></a>
						</li>
						<li class="breadcrumb-item">
							Payroll
						</li>
						<li class="breadcrumb-item active" aria-current="page">IT Assets Request List</li>
					</ol>
				</nav>
			</div>
			<div class="d-flex my-xl-auto right-content align-items-center flex-wrap ">

				<div class="mb-2">
					<a href="#" data-bs-toggle="modal" data-bs-target="#add_employeeAssets" class="btn btn-primary d-flex align-items-center"><i class="ti ti-circle-plus me-2"></i>Create New</a>
				</div>

			</div>
		</div>
		<!-- /Breadcrumb -->
		<div class="card">
			<div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
				<h5>IT Assets Request List</h5>
				<div class="d-flex my-xl-auto right-content align-items-center flex-wrap row-gap-3">

					<div class="dropdown me-3">
						<a href="javascript:void(0);" class="dropdown-toggle btn btn-white d-inline-flex align-items-center" data-bs-toggle="dropdown">
							Employee
						</a>
						<ul class="dropdown-menu  dropdown-menu-end p-3">
							<li>
								<a href="javascript:void(0);" class="dropdown-item rounded-1">Finance</a>
							</li>
							<li>
								<a href="javascript:void(0);" class="dropdown-item rounded-1">Developer</a>
							</li>
							<li>
								<a href="javascript:void(0);" class="dropdown-item rounded-1">Executive</a>
							</li>
						</ul>
					</div>
					<div class="dropdown me-3">
						<a href="javascript:void(0);" class="dropdown-toggle btn btn-white d-inline-flex align-items-center" data-bs-toggle="dropdown">
							Select Status
						</a>
						<ul class="dropdown-menu  dropdown-menu-end p-3">
							<li>
								<a href="javascript:void(0);" class="dropdown-item rounded-1">Active</a>
							</li>
							<li>
								<a href="javascript:void(0);" class="dropdown-item rounded-1">Inactive</a>
							</li>
						</ul>
					</div>
					<button class="btn  bg-primary btn-wave waves-effect waves-light">
						<i class="feather-search align-middle me-2 d-inline-block"></i>Search
					</button>

				</div>
			</div>
			<div class="card-body p-0">
				<div class="custom-datatable-filter table-responsive">
					<table class="table datatable">
						<thead class="thead-light">
							<tr>
								<th>Request ID</th>
								<th>Employee Name </th>
							    <th>Asset Type</th>
								<th>Date</th>
								<th>Status</th>
								<th>Actions</th>
								<th>Workflow History</th>
							</tr>
						</thead>
						<tbody>

						@if (Model != null && Model.Any())
						{
							foreach (var item in Model)
							{
								<tr>
									<td>@item.requestId</td>
									<td>@item.employeeName</td>
									<td>@item.loanType</td>									
									<td>
										@{
											string TranceFormatted = "";
											if (!string.IsNullOrWhiteSpace(item.transDate))
											{
												DateTime tempDate;
												if (DateTime.TryParseExact(item.transDate, "yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out tempDate))
												{
													TranceFormatted = tempDate.ToString("dd/MM/yyyy");
												}
												else if (DateTime.TryParse(item.transDate, System.Globalization.CultureInfo.InvariantCulture, out tempDate))
												{
													TranceFormatted = tempDate.ToString("dd/MM/yyyy");
												}
											}
										}
										@TranceFormatted
									</td>
									<td>
										<span class="badge @(item.status == "Draft" ? "badge-danger" : "badge-success") d-inline-flex align-items-center badge-xs">
											<i class="ti ti-point-filled me-1"></i>@item.status
										</span>
									</td>
									<td>
										@if (item.status == "Draft")
										{
											<div class="action-icon d-inline-flex">
												<a href="#" class="me-2 btnViewAssets" data-bs-toggle="modal" data-id="@item.requestId" data-bs-target="#add_employeeAssetsView"><i class="ti ti-eye"></i></a>
												<a href="#" class="me-2 btnView" data-bs-toggle="modal" data-id="@item.requestId" data-bs-target="#add_employeeAssets"><i class="ti ti-edit"></i></a>
												<a href="#" class="me-2" data-bs-toggle="modal" data-rec="@item.workflowPermissionId" data-tableid="@item.workflowTableId" data-requestid="@item.requestId" data-bs-target="#recall_modal"><i class="ti ti-history" title="Recall"></i></a>
											</div>
										}
										else
										{
											<div class="action-icon d-inline-flex">
												<a href="#" class="me-2 btnViewAssets" data-bs-toggle="modal" data-id="@item.requestId" data-bs-target="#add_employeeAssetsView"><i class="ti ti-eye"></i></a>
												<a href="#" class="me-2" data-bs-toggle="modal" data-rec="@item.workflowPermissionId" data-tableid="@item.workflowTableId" data-requestid="@item.requestId" data-bs-target="#recall_modal"><i class="ti ti-history" title="Recall"></i></a>
											</div>
										}
									
									</td>
									<td>
										@* <a href="#" class="me-2" data-bs-toggle="modal" data-bs-target="#Workflow_History" title="View"><i class="ti ti-eye"></i></a> *@
										<a href="#" class="me-2 btnWFView" id="btnWFView" name="btnWFView" data-bs-toggle="modal" data-bs-target="#Workflow_History" data-requestid="@item.requestId"
										   data-rec="@item.recordId" data-tableid="@item.tableId" data-transtype="IT Assets" title="View"><i class="ti ti-eye"></i></a>
									</td>
									
								</tr>							
							}
						}							
						</tbody>
					</table>
				</div>
			</div>
		</div>

	</div>

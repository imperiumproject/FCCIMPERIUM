	//-----------------------------------------------------View-----------------------------

	$(document).on('click', '.btnViewAssets', function () {
		var requestId = $(this).data('id');		
		//------------------	
		$.ajax({
			url: '@Url.Action("ReadAssetRequestDetails", "ITAssets")',
			type: 'Get',
			data: { assetsId: requestId }, // Use 'id' to match controller parameter
			dataType: 'json',
			success: function (response) {
				// Check if leaveDetails exists and has items
				if (response.assetRequestList && response.assetRequestList.length > 0) {
					var requestData = response.assetRequestList[0];
					function formatDate(inputDate) {
						if (!inputDate) return '';
						var parts = inputDate.split('/');
						return `${parts[2]}-${parts[1]}-${parts[0]}`;
					}
					function formatDateReverse(inputDate) {
						if (!inputDate) return '';
						var parts = inputDate.split('-');
						if (parts.length !== 3) return '';
						return `${parts[2]}/${parts[1]}/${parts[0]}`;
					}
									
					$('#add_employeeAssetsView #requestidvw').val(requestData.requestId);
					$('#add_employeeAssetsView #employeenamevw').val(requestData.employeeId + '-' + requestData.employeeName);
					$('#add_employeeAssetsView #loantypevw').val(requestData.loanType);
					$('#add_employeeAssetsView #requiredbyvw').val(formatDate(requestData.requiredBy));
					$('#add_employeeAssetsView #requestedtillvw').val(formatDate(requestData.requiredTill));
					$('#add_employeeAssetsView #purposevw').val(requestData.purpose);
					$('#add_employeeAssetsView #additionaldetailsvw').val(requestData.additionalDetails);
					if (requestData.status == 'Submitted' || requestData.status == 'Approved') {
						$('#btnItAssestSubmite').hide();						
					}
					var table = $('#AssetsattachmentsTable').DataTable();
					$('#add_employeeAssetsView #noofattachmentsvw').val(requestData.attachRefList.length);
					$.each(requestData.attachRefList, function (i, item) {
						// Determine the MIME type (default to octet-stream if unknown)
						let mimeType = item.fileType || 'application/octet-stream';

						// Construct download link using base64
						let downloadLink = `<a href="data:${mimeType};base64,${item.attachRef}"
								 download="${item.fileName}"
								 target="_blank">${item.fileName}</a>`;
						// Conditionally set the delete link based on requestData.status
						let deleteLink = (requestData.status === 'Submitted' || requestData.status === 'Approved')
							? `<span class="delete-attachment disabled" style="pointer-events: none; opacity: 0.5;"><i class="ti ti-trash"></i></span>`
							: `<a href="#" class="delete-attachment" data-attachment-id="${item.id || i}" data-bs-toggle="modal" data-bs-target="#delete_modal"><i class="ti ti-trash"></i></a>`;
						table.row.add([
							downloadLink,
							requestData.employeeId + '-' + requestData.employeeName,
							formatDate(requestData.transDate),
							deleteLink
						]).draw(false);
					});
					function formatDate(dateStr) {
						const d = new Date(dateStr);
						return d.toLocaleDateString("en-GB"); // dd/MM/yyyy
					}
				} else {
					alert('Error: No leave details found in response');
				}
			},
			error: function (xhr, status, error) {
				alert('An error occurred while fetching the data: ' + error);
				console.error('AJAX Error:', xhr.responseText); // Log response for debugging
			}
		});
	});
	

	// Optional: Display selected files in the UI
	$('#attachmentslist').on('change', function () {
		const files = this.files;
		let fileList = '';
		let count = 0;
		for (let i = 0; i < files.length; i++) {
			fileList += `<li>${files[i].name} (${(files[i].size / 1024).toFixed(2)} KB)</li>`;
			count++;
		}
		$('#fileList').html(fileList ? `<ul>${fileList}</ul>` : 'No files selected.');
		$('#noofattachments').val(count);
	});



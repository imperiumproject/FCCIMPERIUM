<script>
	$(document).ready(function () {
		fetchAssetsId();
		BindAllEmployee("");
		BindLoanType();


		// Function to parse date (assuming format dd/mm/yyyy)
		function parseDate(dateStr) {
			if (!dateStr) return null;
			// Assuming date format is dd/mm/yyyy
			var parts = dateStr.split('/');
			if (parts.length !== 3) return null;
			// Create Date object (month is 0-based in JavaScript)
			return new Date(parts[2], parts[1] - 1, parts[0]);
		}

		// Event handler for requestedtill input
		$('#requestedtill').on('change', function () {
			console.log('requestedtill change event triggered'); // Debugging
			var leaveStart1 = $('#requiredby').val();
			var leaveEnd1 = $('#requestedtill').val();

			if (leaveStart1 && leaveEnd1) {
				var startDate = parseDate(leaveStart1);
				var endDate = parseDate(leaveEnd1);

				if (!startDate || !endDate) {
					alert('Invalid date format.');
					return false;
				}

				if (endDate < startDate) {
					alert('Request till date cannot be earlier than required by date.');
					$('#requestedtill').focus();
					$('#errorMessage').html('Request till date cannot be earlier than required by date.');
					return false;
				} else {
					$('#errorMessage').html('');
				}
			}
		});

		// Event handler for requiredby input
		$('#requiredby').on('change', function () {
			console.log('requiredby change event triggered'); // Debugging
			var leaveStart1 = $('#requiredby').val();
			var leaveEnd1 = $('#requestedtill').val();

			if (leaveStart1 && leaveEnd1) {
				var startDate = parseDate(leaveStart1);
				var endDate = parseDate(leaveEnd1);

				if (!startDate || !endDate) {
					alert('Invalid date format.');
					return false;
				}

				if (endDate < startDate) {
					alert('Request till date cannot be earlier than required by date.');
					$('#requiredby').focus();
					$('#errorMessage').html('Request till date cannot be earlier than required by date.');
